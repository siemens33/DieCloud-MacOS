<Window x:Class="DieCloud.VpnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN — только DieCloud"
        Height="540" Width="700"
        MinHeight="440" MinWidth="600"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0E1013"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#0E1013">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/> <!-- Titlebar -->
            <RowDefinition Height="*"/>  <!-- Main Content -->
            <RowDefinition Height="60"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Custom Header -->
        <Border Grid.Row="0" Background="#14161C" BorderBrush="#1F232B" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid Margin="14,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="VPN — только DieCloud" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                </StackPanel>
                <Button Click="BtnClose_Click" HorizontalAlignment="Right" Width="36" Height="36"
                        Style="{StaticResource TitleBarCloseButtonStyle}">
                    <TextBlock Text="✕" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,14">
                <!-- Section 1: ПОДПИСКА -->
                <TextBlock Text="ПОДПИСКА" FontSize="10" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtSubscription" Background="#16181F" Foreground="#FFFFFF" BorderBrush="#2A2F3D"
                         Padding="10,7" FontSize="12" Margin="0,0,0,8" ToolTip="Вставьте ссылку подписки или конфигурационный ключ"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="BtnRefreshKey" Click="BtnRefreshKey_Click" Content="Обновить ключ"
                            Style="{StaticResource TitleBarActionButtonStyle}" Padding="12,5" Width="Auto" Height="28" Margin="0,0,10,0"/>
                    <Button x:Name="BtnPingAll" Click="BtnPingAll_Click" Content="Проверить пинг"
                            Style="{StaticResource TitleBarActionButtonStyle}" Padding="12,5" Width="Auto" Height="28"/>
                </StackPanel>

                <!-- Row: Автоподключение -->
                <Border Background="#16181F" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Автоподключение при запуске" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Вернётся к выбранному серверу автоматически" FontSize="11" Foreground="#8A92A6" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAutoConnect" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Style="{StaticResource ModernToggleSwitchStyle}" Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed"/>
                    </Grid>
                </Border>

                <!-- Separator -->
                <Border Height="1" Background="#1F232B" Margin="0,0,0,14"/>

                <!-- Section 2: СЕРВЕРЫ -->
                <TextBlock Text="СЕРВЕРЫ" FontSize="10" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>

                <!-- Servers Table -->
                <Border Background="#16181F" BorderBrush="#252A36" BorderThickness="1" CornerRadius="8" MaxHeight="220">
                    <ListView x:Name="LstServers" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                              MouseDoubleClick="LstServers_MouseDoubleClick" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Сервер" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <TextBlock Text="🌐" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Протокол" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#252A35" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ProtocolDisplay}" FontSize="10" FontWeight="Bold" Foreground="#32ADE6"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Пинг" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PingDisplay}" FontSize="11" Foreground="#A0A8BA" Margin="4,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <TextBlock Text="Двойной клик по серверу — подключить." FontSize="11" Foreground="#5A6170" Margin="4,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#12141A" BorderBrush="#1F232B" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDot" Text="●" Foreground="#6C757D" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="VPN выключен" FontSize="12" Foreground="#A0A8BA" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnToggleConnect" Click="BtnToggleConnect_Click" Content="Подключить"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ModernPrimaryButtonStyle}" Padding="20,8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
